{
  "name": "lume-clinic",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w apps/web",
    "seed": "npm run seed -w apps/api",
    "test": "npm test -w apps/api",
    "keys": "node -e \"const c=require('crypto');console.log('JWT_SECRET='+c.randomBytes(48).toString('hex'));console.log('ENCRYPTION_KEY='+c.randomBytes(32).toString('hex'))\""
  },
  "devDependencies": { "concurrently": "^8.2.2" }
}
